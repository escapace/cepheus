{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["ncu"],
  "ignoreDependencies": ["@commitlint/cli", "wrangler", "pangram", "@tweakpane/core"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "lefthook": {
    "config": []
  },
  "workspaces": {
    "packages/*": {
      "entry": ["src/{worker,index,cli,entry-*}.ts!"],
      "ignore": ["**/drafts/**", "scripts/max-delta.ts"],
      "project": ["{src,scripts}/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,vue}"]
    }
  }
}
