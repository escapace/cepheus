{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "**/*.{test,spec}.?(c|m)[jt]s?(x)",
    "**/test/**/*.?(c|m)[jt]s?(x)",
    "eslint.config.mjs",
    "pangram.config.ts",
    "src/entry-server.ts!",
    "src/entry-browser.ts!",
    "src/create-app.ts!",
    "src/models/*.ts",
    "src/*.d.ts",
    "index.html",
    "{scripts,perf}/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}"
  ],
  "ignore": ["**/*.d.+([a-zA-Z0-9]).ts", "dist/**", "src/drafts/**"],
  "ignoreBinaries": ["ncu"],
  "ignoreDependencies": [
    "@cepheus/plugin",
    "@cepheus/utilities",
    "@cepheus/vue",
    "@commitlint/cli",
    "@microsoft/api-extractor",
    "cepheus",
    "eslint-config-escapace",
    "prettier",
    "syncpack",
    "tsx",
    "uno.css",
    "wrangler"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "lefthook": {
    "config": []
  },
  "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,vue}"]
}
